{
  "name": "society-promo",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "audio": "python3 scripts/banda_sonora.py",
    "render": "remotion render src/index.ts SocietyPromo out/society-promo-9x16-muda.mp4 --muted --crf=19 --x264-preset=slow",
    "render:wide": "remotion render src/index.ts SocietyPromoWide out/society-promo-16x9-muda.mp4 --muted --crf=18 --x264-preset=slow",
    "export": "python3 scripts/exportar.py",
    "still": "remotion still src/index.ts SocietyPromo out/frame.png",
    "render:pizza": "remotion render src/index.ts SocietyPizza out/society-anuncio-pizza.mp4 --gl=angle --crf=16",
    "render:startup": "remotion render src/index.ts SocietyPizzaStartup out/society-anuncio-pizza-startup.mp4 --gl=angle --crf=16",
    "render:recortado": "remotion render src/index.ts SocietyRecortado out/society-terraza-recortada.mp4 --crf=16",
    "render:como-funciona": "remotion render src/index.ts SocietyComoFunciona out/society-como-funciona.mp4 --crf=18",
    "logo": "remotion still src/index.ts SocietyLogo ../society-identidad-editorial/logos/society-logo-oficial.png --frame=50",
    "render:agencia": "remotion render src/index.ts SocietyAgencia out/society-agencia.mp4 --crf=18 --timeout=120000"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.1",
    "@remotion/cli": "^4.0.528",
    "@remotion/fonts": "^4.0.528",
    "@remotion/three": "4.0.528",
    "@remotion/transitions": "^4.0.528",
    "delaunator": "5.1.0",
    "gsap": "3.15.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.528",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/delaunator": "^5.0.3",
    "@types/react": "^19.3.0",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2"
  }
}
